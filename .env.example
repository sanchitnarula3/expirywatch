# ExpiryWatch Cloud Environment Configuration
# Copy this file to .env.local and fill in your keys from the Supabase dashboard

# 1. Supabase Project Configuration (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Server-side Supabase Service Role Key (NEVER expose to browser / client code)
# Used by background scheduled jobs (Cron) and admin server operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Member 3: Email & Scheduled Cron Configuration
RESEND_API_KEY=your-resend-api-key
CRON_SECRET=your-random-cron-secret-token
RESEND_FROM_EMAIL=ExpiryWatch <reminders@your-verified-domain.com>
